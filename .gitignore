cat > .gitignore << 'EOF'
# Секреты
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Логи и временные файлы
*.log
*.tmp
EOF

# пользовательские данные — не в публичный репозиторий
data/whitelist.json
data/access_state.json
data/consents.json
data/user_modes.json
user_modes.json
whitelist.json
archive/parser.py
archive/bot_report.py
archive/bot_test.py
